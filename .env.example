# Everything here is optional. The app works with no keys at all (free OpenStreetMap data).

# Enables the "Show reviews" button on each cafe (Google rating, review snippets, popular items).
# The key is only used when you click that button. See README.md for setup.
GOOGLE_PLACES_API_KEY=

# Safety cap on review lookups per day, to protect your Google free allowance (default 100).
# REVIEWS_DAILY_LIMIT=100

# Advanced / costs more: use Google for the main search too (20 results with ratings and photos).
# GOOGLE_FULL_SEARCH=true

# Optional AI vibe summaries (needs the Google key as well).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Reading cafes' own websites for extra details is on by default. Set to false to turn it off.
# ENRICH_WEBSITES=false

# Optional: find YouTube videos about a cafe automatically (a free key from Google Cloud: enable "YouTube Data API v3").
# Used only when you click "Press & mentions", cached for a week, capped per day. Check Google's current quota rules.
YOUTUBE_API_KEY=
# YOUTUBE_DAILY_LIMIT=30
